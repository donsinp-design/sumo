{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kumite",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-09-15",

  // Only the public folder is uploaded: the game files players need.
  "assets": { "directory": "./public", "binding": "ASSETS" },

  // Serve the game at looktwicestudio.com/kumite/ (and a backup workers.dev address)
  "workers_dev": true,
  "routes": [
    { "pattern": "looktwicestudio.com/kumite*", "zone_name": "looktwicestudio.com" }
  ],
  "vars": { "BASE_PATH": "/kumite" },

  // One Durable Object per online room
  "durable_objects": { "bindings": [ { "name": "ROOMS", "class_name": "Room" } ] },
  "migrations": [ { "tag": "v1", "new_sqlite_classes": ["Room"] } ]
}
